# Copy to .env.demo and use a dedicated local PostgreSQL database called taskflow_demo.
# The seed script refuses non-loopback hosts and reads DEMO_DATABASE_URL only.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/taskflow_demo
DEMO_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/taskflow_demo
JWT_SECRET=local-demo-only-change-this-to-a-random-value
PORT=4000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
