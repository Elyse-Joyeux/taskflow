# Neon pooled connection string (Neon dashboard > Connect)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional isolated database for integration tests. Never point this at production.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/taskflow_test
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=4000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Gmail example. Use a valid Gmail address and a Google App Password (not your login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Taskflow <your-address@gmail.com>
